{
  "source_ref": "d923a5eb",
  "note": "Recorded from a throwaway Hermes (GET /api/fs/*) on a made-up folder; invented names, paths rewritten to /srv/demo. Source: hermes_cli/web_routers/files.py. Large and binary bodies are shortened. content-length is kept only for the file download; the other recorded lengths described the full bodies and are dropped.",
  "cases": {
    "list_folder": {
      "request": {
        "route": "/api/fs/list",
        "query": {
          "profile": "default",
          "path": "/srv/demo/proj"
        }
      },
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "entries": [
          {
            "name": ".hiddendir",
            "path": "/srv/demo/proj/.hiddendir",
            "isDirectory": true
          },
          {
            "name": "empty",
            "path": "/srv/demo/proj/empty",
            "isDirectory": true
          },
          {
            "name": "real",
            "path": "/srv/demo/proj/real",
            "isDirectory": true
          },
          {
            "name": "src",
            "path": "/srv/demo/proj/src",
            "isDirectory": true
          },
          {
            "name": ".dotnote",
            "path": "/srv/demo/proj/.dotnote",
            "isDirectory": false
          },
          {
            "name": "big.txt",
            "path": "/srv/demo/proj/big.txt",
            "isDirectory": false
          },
          {
            "name": "blob.bin",
            "path": "/srv/demo/proj/blob.bin",
            "isDirectory": false
          },
          {
            "name": "link",
            "path": "/srv/demo/proj/link",
            "isDirectory": false
          },
          {
            "name": "README.md",
            "path": "/srv/demo/proj/README.md",
            "isDirectory": false
          }
        ]
      },
      "note": "dir first then files, case-insensitive; .git node_modules .env hidden; .dotnote and .hiddendir shown; the symlink `link` -> real reports isDirectory false"
    },
