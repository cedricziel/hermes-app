<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Group here: that entitlement needs development signing, and
	     debug builds are signed ad hoc, so sharing only works in signed
	     Release builds. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
