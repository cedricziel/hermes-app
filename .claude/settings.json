{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/install-claude-plugins.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\" --post",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "oss@cedricziel": true,
    "common@cedricziel": true
  },
  "extraKnownMarketplaces": {
    "cedricziel": {
      "source": {
        "source": "github",
        "repo": "cedricziel/claude-plugins",
        "sha": "bc53748a00f21f5aa3dd221e12c90ec69a7cce2c"
      }
    }
  },
  "permissions": {
    "deny": [
      "Bash(git stash *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)"
    ]
  }
}
