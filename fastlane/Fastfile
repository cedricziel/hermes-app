require "yaml"

opt_out_usage

APP_IDENTIFIER       = "com.cedricziel.hermesApp"
EXTENSION_IDENTIFIER = "#{APP_IDENTIFIER}.ShareExtension"
APP_NAME             = "Hermes App"
TEAM_ID        = "WPW3QSLZ2F"
OUTPUT_DIR     = "build/fastlane"
OUTPUT_NAME    = "HermesApp"
PUBLIC_BETA_GROUP    = "Public beta"

TARGETS = {
  ios: {
    flutter_platform: "ios",
    match_platform: "ios",
    deliver_platform: "ios",
    project: "ios/Runner.xcodeproj",
    workspace: "ios/Runner.xcworkspace",
    destination: "generic/platform=iOS",
    artifact: "#{OUTPUT_DIR}/#{OUTPUT_NAME}.ipa",
    extension_targets: ["ShareExtension"],
  },
  mac: {
    flutter_platform: "macos",
    match_platform: "macos",
    deliver_platform: "osx",
    project: "macos/Runner.xcodeproj",
    workspace: "macos/Runner.xcworkspace",
    destination: "generic/platform=macOS",
    artifact: "#{OUTPUT_DIR}/#{OUTPUT_NAME}.pkg",
    extension_targets: ["ShareExtension"],
  },
}.freeze

FLUTTER_ROOT = File.expand_path("..", __dir__)

# Build number = commits reachable from HEAD: monotonic on main and never
# written back into pubspec.yaml.
def commit_count_build_number
  @commit_count_build_number ||= sh("git rev-list --count HEAD", log: false).strip
end

def marketing_version(options)
  explicit = options[:version].to_s.strip
  return explicit unless explicit.empty?

  YAML.load_file(File.join(FLUTTER_ROOT, "pubspec.yaml"))["version"].to_s.split("+").first
end

before_all do |_lane, _options|
  Dotenv.load(".env") if File.exist?(".env")
  # Without setup_ci, codesign on macOS runners hangs on a keychain prompt.
  setup_ci if is_ci
end

platform :ios do
  desc "Build a signed App Store IPA without uploading"
  lane :build do |options|
    build_target(:ios, options)
  end

  desc "Build and upload to TestFlight (internal testers)"
  desc "  version:X.Y.Z  marketing version (default: pubspec.yaml)"
  lane :release do |options|
    release_target(:ios, options)
  end
end

platform :mac do
  desc "Build a signed Mac App Store PKG without uploading"
  lane :build do |options|
    build_target(:mac, options)
  end

  desc "Build and upload to TestFlight (internal testers)"
  desc "  version:X.Y.Z  marketing version (default: pubspec.yaml)"
  lane :release do |options|
    release_target(:mac, options)
  end
end

desc "Register the bundle ID and check for the App Store Connect app record"
lane :bootstrap_app do
  load_app_store_connect_api_key

  { APP_IDENTIFIER => APP_NAME, EXTENSION_IDENTIFIER => "#{APP_NAME} Share Extension" }.each do |identifier, name|
    bundle = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: identifier })
                                            .find { |b| b.identifier == identifier }
    if bundle
      UI.message("Bundle ID #{identifier} already registered (#{bundle.platform})")
    else
      bundle = Spaceship::ConnectAPI::BundleId.create(
        name: name,
        identifier: identifier,
        platform: "UNIVERSAL"
      )
      UI.success("Registered bundle ID #{identifier} (#{bundle.platform})")
    end
  end

  # The App Groups capability and the group container can't be set up through
  # the public API; without them the share extension can't hand content to
  # the app.
  UI.important(<<~MSG)
    In the developer portal (Identifiers), enable "App Groups" on #{APP_IDENTIFIER} and
    #{EXTENSION_IDENTIFIER} and assign both to group.#{APP_IDENTIFIER}, then run
    `fastlane bootstrap_signing force:true` to regenerate the profiles.
  MSG

  # The public API refuses to create app records, so that step stays manual.
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  if app
    UI.message("App record '#{app.name}' (#{app.id}) already exists")
  else
    UI.important(<<~MSG)
      No App Store Connect app record for #{APP_IDENTIFIER} yet. Create it once at
      https://appstoreconnect.apple.com/apps -> "+" -> New App:
        Platforms: iOS, macOS   Name: #{APP_NAME}   Primary language: English (U.S.)
        Bundle ID: #{APP_IDENTIFIER}   SKU: #{APP_IDENTIFIER}
    MSG
  end
end

desc "Upload App Store metadata (listing text, category, age rating) without a binary"
lane :sync_metadata do
  api_key = load_app_store_connect_api_key
  %w[ios osx].each do |platform|
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      platform: platform,
      app_version: marketing_version({}),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      app_rating_config_path: "fastlane/metadata/age_rating.json"
    )
  end
end

desc "Create App Store signing certs and profiles for iOS and macOS via match (writes to the certificates repo)"
desc "  force:true regenerates the profiles"
lane :bootstrap_signing do |options|
  api_key = load_app_store_connect_api_key
  force = options[:force].to_s == "true"
  match(type: "appstore", platform: "ios", readonly: false, force: force, api_key: api_key)
  match(
    type: "appstore",
    platform: "macos",
    additional_cert_types: ["mac_installer_distribution"],
    readonly: false,
    force: force,
    api_key: api_key
  )
end

def build_target(key, options)
  t = TARGETS.fetch(key)
  api_key = load_app_store_connect_api_key
  version = marketing_version(options)
  build_number = commit_count_build_number

  UI.header("#{APP_NAME} #{key} #{version} (#{build_number})")

  match_params = { type: "appstore", platform: t[:match_platform], readonly: is_ci, api_key: api_key }
  match_params[:additional_cert_types] = ["mac_installer_distribution"] if key == :mac
  sync_code_signing(**match_params)

  update_code_signing_settings(
    path: t[:project],
    targets: ["Runner"],
    build_configurations: ["Release"],
    use_automatic_signing: false,
    team_id: TEAM_ID,
    code_sign_identity: "Apple Distribution",
    bundle_identifier: APP_IDENTIFIER,
    profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING].fetch(APP_IDENTIFIER)
  )

  t[:extension_targets].each do |extension_target|
    update_code_signing_settings(
      path: t[:project],
      targets: [extension_target],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      bundle_identifier: EXTENSION_IDENTIFIER,
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING].fetch(EXTENSION_IDENTIFIER)
    )
  end

  # Writes Flutter/Generated.xcconfig and runs pod install without compiling;
  # the archive below does the single real build. Runs after the signing
  # settings so Flutter sees a team and skips its development-cert lookup,
  # which fails on a runner that only has the distribution cert.
  flutter_flags = key == :ios ? " --no-codesign" : ""
  telemetry_flags = telemetry_dart_defines(version).map { |flag| " #{flag.shellescape}" }.join
  sh("cd #{FLUTTER_ROOT.shellescape} && flutter build #{t[:flutter_platform]} --release --config-only#{flutter_flags} " \
     "--build-name=#{version.shellescape} --build-number=#{build_number.shellescape}#{telemetry_flags}")

  build_app(
    workspace: t[:workspace],
    scheme: "Runner",
    configuration: "Release",
    destination: t[:destination],
    export_method: "app-store",
    export_team_id: TEAM_ID,
    output_directory: OUTPUT_DIR,
    output_name: OUTPUT_NAME,
    clean: true,
    include_symbols: true
  )

  { version: version, build_number: build_number }
end

def release_target(key, options)
  t = TARGETS.fetch(key)
  built = build_target(key, options)
  notes_file = ENV["RELEASE_NOTES_FILE"].to_s
  notes = File.read(notes_file).strip if !notes_file.empty? && File.exist?(notes_file)

  params = {
    api_key: load_app_store_connect_api_key,
    app_identifier: APP_IDENTIFIER,
    app_platform: t[:deliver_platform],
    # Distributing to an external group needs the build processed first.
    skip_waiting_for_build_processing: false,
    distribute_external: true,
    groups: [PUBLIC_BETA_GROUP],
    notify_external_testers: true,
    changelog: notes.to_s.empty? ? "Build #{built[:version]} (#{built[:build_number]})" : notes,
  }
  params[key == :mac ? :pkg : :ipa] = t[:artifact]

  upload_to_testflight(**params)
end

# --dart-define flags that point the app's OpenTelemetry export at SignalDB.
# Empty when OTLP_INGEST_URL / OTLP_INGEST_KEY are unset, which builds the app
# with telemetry off instead of failing the build.
def telemetry_dart_defines(version)
  url = ENV["OTLP_INGEST_URL"].to_s.strip
  key = ENV["OTLP_INGEST_KEY"].to_s.strip

  if url.empty? || key.empty?
    UI.important("Telemetry disabled: OTLP_INGEST_URL and/or OTLP_INGEST_KEY not set")
    return []
  end

  # Log the endpoint, never the key.
  UI.message("Telemetry enabled: exporting OTLP to #{url}")
  [
    "--dart-define=OTEL_EXPORTER_OTLP_ENDPOINT=#{url}",
    "--dart-define=OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer #{key},x-tenant-id=homelab,x-dataset-id=apps",
    "--dart-define=OTEL_SERVICE_NAME=hermes-app",
    "--dart-define=OTEL_SERVICE_VERSION=#{version}",
    "--dart-define=OTEL_DEPLOYMENT_ENVIRONMENT=production",
  ]
end

def load_app_store_connect_api_key
  return @asc_api_key if @asc_api_key

  env = ->(name) {
    value = ENV[name]
    value.nil? || value.strip.empty? ? nil : value
  }
  key_id      = env.call("ASC_KEY_ID")
  issuer_id   = env.call("ASC_ISSUER_ID")
  key_path    = env.call("ASC_KEY_PATH")
  key_content = env.call("ASC_KEY_CONTENT")

  if key_id.nil? || issuer_id.nil? || (key_path.nil? && key_content.nil?)
    UI.user_error!(<<~MSG)
      Missing App Store Connect API key configuration. Set ASC_KEY_ID,
      ASC_ISSUER_ID and either ASC_KEY_PATH or ASC_KEY_CONTENT.
      Locally: copy fastlane/.env.default to fastlane/.env and fill in.
      In CI:   configure them as GitHub Actions secrets.
    MSG
  end

  params = { key_id: key_id, issuer_id: issuer_id, in_house: false }
  if key_path
    params[:key_filepath] = key_path
  else
    params[:key_content] = key_content
    params[:is_key_content_base64] =
      key_content.match?(/\A[A-Za-z0-9+\/=\s]+\z/) && !key_content.include?("BEGIN PRIVATE KEY")
  end
  @asc_api_key = app_store_connect_api_key(**params)
end

error do |lane, exception|
  UI.error("Lane #{lane} failed: #{exception.message}")
end
